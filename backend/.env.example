# ---------------------------------------------------
# Degreeverse360 CRM — Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to git.
# ---------------------------------------------------

# PostgreSQL connection string
# Example (Supabase/Render/Railway/Neon all provide one of these):
# postgresql://username:password@host:5432/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/degreeverse360

# Set to "false" only for local Postgres without SSL. Leave "true" for hosted DBs.
DB_SSL=true

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Port the API server listens on (hosting platforms usually set this automatically)
PORT=4000

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=https://crm.degreeverse.com,https://www.degreeverse.com
CORS_ORIGIN=*

# Used only by `npm run seed` to create the first Super Admin account
SEED_ADMIN_NAME=Degreeverse Super Admin
SEED_ADMIN_EMAIL=admin@degreeverse.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_SAMPLE_DATA=false
